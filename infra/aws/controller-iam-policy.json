{
  "Version": "2012-10-17",
  "Comment": "ReaVector CONTROLLER policy (attach to the t3.micro instance role). Least privilege: it may ONLY describe/start/stop the single configured GPU instance, and use the job queue + asset buckets. Replace the placeholders. This file contains no credentials. Nothing applies it automatically.",
  "Statement": [
    {
      "Sid": "DescribeOnlyTheGpuInstance",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "ec2:Region": "ap-southeast-2" }
      }
    },
    {
      "Sid": "StartStopOnlyTheGpuInstance",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances"],
      "Resource": "arn:aws:ec2:ap-southeast-2:ACCOUNT_ID:instance/GPU_INSTANCE_ID"
    },
    {
      "Sid": "SendAndReadJobQueue",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage", "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": [
        "arn:aws:sqs:ap-southeast-2:ACCOUNT_ID:reavectors-jobs",
        "arn:aws:sqs:ap-southeast-2:ACCOUNT_ID:reavectors-jobs-dlq"
      ]
    },
    {
      "Sid": "PresignAndManageUserAssets",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::reavectors-user-assets",
        "arn:aws:s3:::reavectors-user-assets/*"
      ]
    },
    {
      "Sid": "ReadOnlyModelCache",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::reavectors-model-cache",
        "arn:aws:s3:::reavectors-model-cache/*"
      ]
    }
  ]
}
