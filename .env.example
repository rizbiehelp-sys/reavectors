# reavectors environment — TEMPLATE ONLY
# ---------------------------------------------------------------------------
# Copy this to `.env` for LOCAL development. Do NOT commit a real `.env`.
# In production, set these as *encrypted* variables on the host:
#   Render Dashboard -> your service -> Environment  (or via the Render API)
# That keeps secrets out of git and lets you rotate them any time.
#
# Rotate by editing the value in the host dashboard (Render) and redeploying —
# no code change required.
# ---------------------------------------------------------------------------

# ---- Supabase backend (optional) ------------------------------------------
# Enables /api/stats and the conversion log. The service-role key is a SECRET:
# server-side only, never in the browser, never in git.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# ---- server -----------------------------------------------------------------
PORT=8756
HOST=127.0.0.1
PYTHON_VERSION=3.12.6

# ---- native libs (keep BLAS single-threaded on small hosts) -----------------
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1

# ---- limits & security ------------------------------------------------------
REAVECTORS_MAX_UPLOAD_MB=12
REAVECTORS_MAX_DIM=8000
REAVECTORS_MAX_PIXELS=40000000
REAVECTORS_RATE=60
REAVECTORS_REFINE_RATE=12
REAVECTORS_MAX_CONCURRENCY=4
REAVECTORS_MAX_SIZE=1600
REAVECTORS_REFINE_MAX_SECONDS=12
REAVECTORS_CACHE_SIZE=128
REAVECTORS_STATS_CACHE_SECONDS=30
REAVECTORS_SUPABASE_KEEPALIVE_SECONDS=3600

# Set to require "X-API-Key" on /api/* (unlisted-link mode). Leave empty = public.
REAVECTORS_API_KEY=
# Extra browser origins allowed to call the API (comma separated).
REAVECTORS_CORS_ORIGINS=
