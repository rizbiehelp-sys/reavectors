# reavectors environment — TEMPLATE ONLY (copy to `.env`, which is git-ignored)
# ---------------------------------------------------------------------------
# Where secrets live:
#   * LOCAL:   this file copied to `.env` (git-ignored). Paste rotated keys here.
#   * RUNTIME: the host's environment (Render -> Environment) — set via the
#              Render API or dashboard. Secrets are NEVER committed to git.
# To rotate: update the value here and/or on Render, then redeploy. No code change.
# ---------------------------------------------------------------------------

# ============================ AUTOMATION (local only) ======================
# Used by scripts/ to deploy and to push env vars to Render. Never shipped.

# Render API key — paste your NEW key here after rotating it:
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-dbqngj2jnfac739853c0

# Supabase Management API token (create/rotate keys, run SQL via automation):
SUPABASE_ACCESS_TOKEN=

# GitHub token (only if a script pushes for you; prefer `gh auth`/credential mgr):
GITHUB_TOKEN=

# ============================ RUNTIME ======================================
# The running service reads these. On Render they are set as env vars (not from
# this file). Locally, `.env` is auto-loaded by reavectors.config.

# ---- Supabase backend (optional) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# ---- server ----
PORT=8756
HOST=127.0.0.1
PYTHON_VERSION=3.12.6

# ---- native libs (keep BLAS single-threaded on small hosts) ----
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1

# ---- limits & security ----
REAVECTORS_MAX_UPLOAD_MB=12
REAVECTORS_MAX_DIM=8000
REAVECTORS_MAX_PIXELS=40000000
REAVECTORS_RATE=60
REAVECTORS_REFINE_RATE=12
REAVECTORS_MAX_CONCURRENCY=4
REAVECTORS_MAX_SIZE=1600
REAVECTORS_REFINE_MAX_SECONDS=12
REAVECTORS_CACHE_SIZE=128
REAVECTORS_STATS_CACHE_SECONDS=30
REAVECTORS_SUPABASE_KEEPALIVE_SECONDS=3600

# Set to require "X-API-Key" on /api/* (unlisted-link mode). Empty = public.
REAVECTORS_API_KEY=
# Extra browser origins allowed to call the API (comma separated).
REAVECTORS_CORS_ORIGINS=

# ============================ AI STUDIO ====================================
# GPU compute scales to zero. Defaults keep ALL real AWS calls OFF (mock only).
AI_ENABLED=1
AI_GPU_PROVIDER=mock              # mock | ec2
AI_ENABLE_REAL_GPU=0              # HARD safety gate for the EC2 provider
AI_GPU_INSTANCE_ID=               # the g4dn.xlarge id (NOT the t3.micro)
AI_GPU_REGION=ap-southeast-2
AI_JOB_DB_PATH=./data/ai_jobs.db  # SQLite (WAL)
AI_QUEUE_BACKEND=sqlite           # sqlite | sqs
AI_S3_BUCKET=                     # empty => local dev storage
AI_USE_API_FALLBACK=0
AI_ALLOW_PAID_FALLBACK=0

# --- rate limits / abuse protection ---
AI_RATE_REQUESTS_PER_MINUTE=3
AI_MAX_PENDING_PER_USER=2
AI_MAX_DAILY_IMAGE_JOBS=20
AI_MAX_DAILY_VIDEO_JOBS=4
AI_MAX_DAILY_3D_JOBS=10
AI_MAX_GLOBAL_QUEUE=25
AI_MAX_GPU_ACTIVE_JOBS=1

# --- GPU lifecycle / cost ---
AI_IDLE_GRACE_SECONDS=600
AI_MAX_GPU_SESSION_SECONDS=3600
AI_MAX_GPU_SECONDS_PER_DAY=21600
AI_MAX_GPU_SECONDS_PER_MONTH=200000
AI_BUDGET_MAX_USD=100
AI_GPU_USD_PER_HOUR=0.53

# --- Product photo -> 3D refine budget (seconds; the pipeline works until spent) ---
REAVECTORS_PRODUCT3D_REFINE_SECONDS=30
REAVECTORS_PRODUCT3D_REFINE_MIN=10
REAVECTORS_PRODUCT3D_REFINE_MAX=120

# --- timeouts (seconds) ---
AI_IMAGE_INFERENCE_TIMEOUT_SECONDS=180
AI_GPU_STARTUP_TIMEOUT_SECONDS=600
AI_VIDEO_JOB_TIMEOUT_SECONDS=1200
AI_IMAGE_3D_JOB_TIMEOUT_SECONDS=600

# --- optional admin override key (separate from REAVECTORS_API_KEY) ---
AI_ADMIN_KEY=

# --- Tripo hosted image->3D (PAID; opt-in, OFF by default) ---
# 1 credit = \.01; image->3D = 20-30 credits (\.20-\.30) PER MODEL.
# Needs the SECRET key (starts with tsk_), NOT the client id (tcli_).
AI_ENABLE_TRIPO=0
AI_TRIPO_API_KEY=
AI_TRIPO_BASE=https://openapi.tripo3d.ai/v3
AI_TRIPO_MODEL=v3.1-20260211
AI_TRIPO_TEXTURE_QUALITY=standard
AI_TRIPO_MAX_USD_PER_JOB=0.35

# --- 3D AI Studio hosted Hunyuan 3D (PAID credits; opt-in, OFF by default) ---
# Pro = 60 credits (+20 PBR, +20 multi-view). Endpoint: /v1/3d-models/tencent/generate/pro/
AI_ENABLE_3DAS=0
AI_3DAS_API_KEY=
AI_3DAS_BASE=https://api.3daistudio.com
AI_3DAS_MODEL=3.1
AI_3DAS_ENABLE_PBR=1
AI_3DAS_FACE_COUNT=500000
AI_3DAS_MAX_DAILY_JOBS=5
AI_3DAS_TIMEOUT=30
AI_3DAS_ASSET_HOSTS=3daistudio.com
