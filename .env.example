# reavectors environment — TEMPLATE ONLY (copy to `.env`, which is git-ignored)
# ---------------------------------------------------------------------------
# Where secrets live:
#   * LOCAL:   this file copied to `.env` (git-ignored). Paste rotated keys here.
#   * RUNTIME: the host's environment (Render -> Environment) — set via the
#              Render API or dashboard. Secrets are NEVER committed to git.
# To rotate: update the value here and/or on Render, then redeploy. No code change.
# ---------------------------------------------------------------------------

# ============================ AUTOMATION (local only) ======================
# Used by scripts/ to deploy and to push env vars to Render. Never shipped.

# Render API key — paste your NEW key here after rotating it:
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-dbqngj2jnfac739853c0

# Supabase Management API token (create/rotate keys, run SQL via automation):
SUPABASE_ACCESS_TOKEN=

# GitHub token (only if a script pushes for you; prefer `gh auth`/credential mgr):
GITHUB_TOKEN=

# ============================ RUNTIME ======================================
# The running service reads these. On Render they are set as env vars (not from
# this file). Locally, `.env` is auto-loaded by reavectors.config.

# ---- Supabase backend (optional) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# ---- server ----
PORT=8756
HOST=127.0.0.1
PYTHON_VERSION=3.12.6

# ---- native libs (keep BLAS single-threaded on small hosts) ----
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1

# ---- limits & security ----
REAVECTORS_MAX_UPLOAD_MB=12
REAVECTORS_MAX_DIM=8000
REAVECTORS_MAX_PIXELS=40000000
REAVECTORS_RATE=60
REAVECTORS_REFINE_RATE=12
REAVECTORS_MAX_CONCURRENCY=4
REAVECTORS_MAX_SIZE=1600
REAVECTORS_REFINE_MAX_SECONDS=12
REAVECTORS_CACHE_SIZE=128
REAVECTORS_STATS_CACHE_SECONDS=30
REAVECTORS_SUPABASE_KEEPALIVE_SECONDS=3600

# Set to require "X-API-Key" on /api/* (unlisted-link mode). Empty = public.
REAVECTORS_API_KEY=
# Extra browser origins allowed to call the API (comma separated).
REAVECTORS_CORS_ORIGINS=
